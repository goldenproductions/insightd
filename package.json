{
  "name": "insightd",
  "version": "1.0.0",
  "description": "Self-hosted server awareness tool — proactive digests, not dashboards",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "collect": "tsx -e \"require('./src/index.ts')\"",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "monitoring",
    "docker",
    "digest",
    "homelab"
  ],
  "author": "goldenproductions",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dockerode": "^5.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dockerode": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "js-yaml": "^4.2.0",
    "mqtt": "^5.15.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
